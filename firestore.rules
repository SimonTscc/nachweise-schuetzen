rules_version = '2';

// Sicherheitsregeln fuer das Firebase-Projekt "nachweise-schuetzen".
// Zugriff nur fuer angemeldete Nutzer (geteilter Vereinslogin).
// In der Firebase-Konsole unter Firestore Database > Regeln einsetzen
// und veroeffentlichen.
// Das VM-Projekt "schiessen" wird davon nicht beruehrt.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
